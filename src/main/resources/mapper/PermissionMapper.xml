<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.dam.mapper.PermissionMapper">

    <resultMap id="permissionResultMap" type="org.dam.entity.Permission">
        <id property="id" column="id"/>
        <result property="permissionCode" column="permission_code"/>
        <result property="permissionName" column="permission_name"/>
        <result property="type" column="type"/>
        <result property="parentId" column="parent_id"/>
        <result property="path" column="path"/>
        <result property="method" column="method"/>
        <result property="description" column="description"/>
        <result property="sort" column="sort"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="createBy" column="create_by"/>
        <result property="updateBy" column="update_by"/>
        <result property="deleted" column="deleted"/>
    </resultMap>

    <select id="selectPermissionsByUserId" resultMap="permissionResultMap">
        SELECT DISTINCT p.*
        FROM sys_permission p
        INNER JOIN sys_role_permission rp ON p.id = rp.permission_id
        INNER JOIN sys_user_role ur ON rp.role_id = ur.role_id
        WHERE ur.user_id = #{userId}
          AND ur.deleted = 0
          AND rp.deleted = 0
          AND p.deleted = 0
          AND p.status = 1
        ORDER BY p.sort ASC
    </select>

    <select id="selectPermissionsByRoleId" resultMap="permissionResultMap">
        SELECT p.*
        FROM sys_permission p
        INNER JOIN sys_role_permission rp ON p.id = rp.permission_id
        WHERE rp.role_id = #{roleId}
          AND rp.deleted = 0
          AND p.deleted = 0
          AND p.status = 1
        ORDER BY p.sort ASC
    </select>

    <select id="selectUnassignedPermissionsByRoleId" resultMap="permissionResultMap">
        SELECT p.*
        FROM sys_permission p
        LEFT JOIN sys_role_permission rp
            ON p.id = rp.permission_id
            AND rp.role_id = #{roleId}
            AND rp.deleted = 0
        WHERE rp.id IS NULL
          AND p.deleted = 0
          AND p.status = 1
        ORDER BY p.sort ASC
    </select>

</mapper>
